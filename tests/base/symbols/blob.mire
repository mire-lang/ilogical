// Per-symbol suite: ilogical::base blobs.
//
// Cases: success (blob copies bytes and reports length/pointer), limit (zero
// length), anomaly (the blob owns a copy: mutating the source buffer after
// construction must not change it).

load ilogical
load mire::bytes
load mire::str
load! /tests/_support/harness

@[test]
pub fn blob_success_ptr_and_len: () :bool {
    set buf = bytes::alloc(3)
    bytes::set_u8(buf, 0, 10)
    bytes::set_u8(buf, 1, 20)
    bytes::set_u8(buf, 2, 30)
    set b = base::blob(buf, 3)
    set ptr = base::as_bytes_ptr(b)
    set ok = true :bool mut
    if !use! harness::check_i64("base/blob/len", base::as_bytes_len(b), 3) { set ok = false }
    if !use! harness::check_i64("base/blob/byte_0", bytes::get_u8(ptr, 0), 10) { set ok = false }
    if !use! harness::check_i64("base/blob/byte_1", bytes::get_u8(ptr, 1), 20) { set ok = false }
    if !use! harness::check_i64("base/blob/byte_2", bytes::get_u8(ptr, 2), 30) { set ok = false }
    return ok
}

@[test]
pub fn blob_limit_empty: () :bool {
    set buf = bytes::alloc(0)
    set b = base::blob(buf, 0)
    set ok = true :bool mut
    if !use! harness::check_i64("base/blob/empty_len", base::as_bytes_len(b), 0) { set ok = false }
    if !use! harness::check("base/blob/empty_is_bytes", base::is_bytes(b)) { set ok = false }
    return ok
}

@[test]
pub fn blob_anomaly_owns_copy: () :bool {
    set buf = bytes::alloc(2)
    bytes::set_u8(buf, 0, 1)
    bytes::set_u8(buf, 1, 2)
    set b = base::blob(buf, 2)
    bytes::set_u8(buf, 0, 99)
    set ptr = base::as_bytes_ptr(b)
    set after = bytes::get_u8(ptr, 0)
    set ok = use! harness::check_i64("base/blob/owns_copy", after, 1)
    use! harness::anomaly("base", "blob/source_mutated", "source[0]=99", "1", str::from::i64(after), after == 1)
    return ok
}
